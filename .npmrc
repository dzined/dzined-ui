# npm 7+ installs peerDependencies automatically. Here that means a second copy
# of React in this repo's node_modules, which the demo bundle then picks up
# alongside the portal's copy; two React instances in one bundle give you
# "Invalid hook call" and a blank page. The demo borrows React from the portal
# (see demo/build.mjs), so this repo wants esbuild and nothing else.
legacy-peer-deps=true
